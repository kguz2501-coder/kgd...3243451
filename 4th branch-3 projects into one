justify-content: center;
max-width: 800px;
margin: 0 auto;
 .project {
border: 1px solid #000;
border-radius: 10px;
padding: 10px;
margin-right: 20px;
  
}

// 1. Get all the project divs
const projects = documents.querySelectorAll('.project');

// Event listeners for mouseenter and mouseleave to create the hover effect
projects.forEach(project => {
      project.addEventListener('mouseenter', () =>  {
        project.style.transform = 'scale(1.1)';
        project.style.transition = 'tranform 0.3s ease';
    });
  
       project.addEventListener('mouseenleave', () =>  {
        project.style.transform = 'scale(1)';
        project.style.transition = 'tranform 0.3s ease';
    });
});
